# Runtime secrets. scripts/setup-local.mjs generates the three local signing secrets.
# Use separate random values of at least 32 characters. Share ONLY the bridge secret
# between the app Worker and MCP Worker. Never use development values in production.
SESSION_SECRET=
DOWNLOAD_SECRET=
OAUTH_BRIDGE_SECRET=

# Test/sandbox key for development; prefer a restricted key with required permissions.
# Creator sales use Stripe-Account; platform billing never does.
STRIPE_SECRET_KEY=
# Public key from the same account; loads Connect embedded components (Stripe account page).
STRIPE_PUBLISHABLE_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_BILLING_WEBHOOK_SECRET=

# PLATFORM account. The founding lifetime is a Product; checkout prices it from the
# ladder (LTD_PRICE_CENTS + LTD_STEP_CENTS per LTD_STEP_EVERY completed purchases).
# Recurring pricing is intentionally unset until the operator chooses it.
STRIPE_LTD_PRODUCT_ID=
STRIPE_RECURRING_PRICE_ID=

# Hosted Cloudflare Access OTP: public configuration, not secrets.
ACCESS_ISSUER=
ACCESS_AUDIENCE=

# R2 S3 credentials restricted to the private deliverables bucket.
# Required for production browser-to-R2 presigned PUT uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# EMAIL Worker: with a FULFILLMENT_EMAIL send_email binding, EMAIL_FROM is a bare
# address (e.g. delivery@getsore.me). Otherwise the Resend transactional API is used. Verify your sending domain first.
# Development mode records attempts without contacting this provider.
EMAIL_API_KEY=
EMAIL_FROM=

# Leave false until PLATFORM tax settings, tax categories, address and registrations
# have been independently verified. This enables calculation, not tax remittance.
PLATFORM_TAX_ENABLED=false

# Hosted branded OTP also needs a native LOGIN_EMAIL send_email binding.
# AUTH_PROVIDER=email
# OTP_FROM=login@getsore.me
# Keep ACCESS_ISSUER fixed to preserve creator ownership.

# App Worker only. The Analytics Engine SQL API requires Account Analytics Read.
ANALYTICS_ACCOUNT_ID=
ANALYTICS_READ_TOKEN=
