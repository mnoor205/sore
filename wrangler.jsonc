{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coachlane-dev",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
    "redact_query_string": true,
  },
  "analytics_engine_datasets": [
    { "binding": "STOREFRONT_ANALYTICS", "dataset": "sore_storefront_dev" },
  ],
  "ratelimits": [
    {
      "name": "ANALYTICS_LIMITER",
      "namespace_id": "61",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  "vars": {
    "ANALYTICS_DATASET": "sore_storefront_dev",
    "APP_MODE": "development",
    "APP_URL": "http://localhost:3000",
    "MCP_URL": "http://localhost:8788",
    "PLATFORM_FEE_BPS": "0",
    "LTD_PRICE_CENTS": "9900",
    "LTD_STEP_CENTS": "1000",
    "LTD_STEP_EVERY": "5",
    "LTD_LIMIT": "100",
    "MAX_PRODUCTS": "50",
    "MAX_UPLOAD_MB": "25",
    "MAX_STORAGE_MB": "500",
    "AI_GATEWAY_ID": "default",
  },
  // Storefront AI editor: Claude Haiku 5.5 through Cloudflare AI Gateway.
  // The AI binding always runs remotely, also under `wrangler dev`.
  "ai": {
    "binding": "AI",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coachlane-dev",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "coachlane-private-dev",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "FULFILLMENT",
        "queue": "coachlane-email-dev",
      },
    ],
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "coachlane-dev",
    },
  ],
  "env": {
    "production": {
      "name": "coachlane",
      "analytics_engine_datasets": [
        {
          "binding": "STOREFRONT_ANALYTICS",
          "dataset": "sore_storefront_production",
        },
      ],
      "ratelimits": [
        {
          "name": "ANALYTICS_LIMITER",
          "namespace_id": "62",
          "simple": { "limit": 120, "period": 60 },
        },
      ],
      "vars": {
        "ANALYTICS_DATASET": "sore_storefront_production",
        "APP_MODE": "production",
        "APP_URL": "https://REPLACE_APP_DOMAIN",
        "MCP_URL": "https://REPLACE_MCP_DOMAIN",
        "PLATFORM_FEE_BPS": "0",
        "LTD_PRICE_CENTS": "9900",
        "LTD_STEP_CENTS": "1000",
        "LTD_STEP_EVERY": "5",
        "LTD_LIMIT": "100",
        "MAX_PRODUCTS": "50",
        "MAX_UPLOAD_MB": "25",
        "MAX_STORAGE_MB": "500",
        "AI_GATEWAY_ID": "default",
      },
      "ai": {
        "binding": "AI",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "coachlane-production",
          "database_id": "REPLACE_PRODUCTION_D1_ID",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "coachlane-private-production",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "FULFILLMENT",
            "queue": "coachlane-email-production",
          },
        ],
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "coachlane",
        },
      ],
      "workers_dev": false,
    },
    // Isolated public demo of the storefront editor with fictional data only.
    // APP_MODE=development enables the demo-workspace sign-in; no real payments,
    // email or creator accounts. Never point this at staging/production data.
    "demo": {
      "name": "coachlane-editor-demo",
      "vars": {
        "APP_MODE": "development",
        "APP_URL": "https://coachlane-editor-demo.warda.workers.dev",
        "MCP_URL": "https://mcp.getsore.me",
        "PLATFORM_FEE_BPS": "0",
        "LTD_PRICE_CENTS": "9900",
        "LTD_STEP_CENTS": "1000",
        "LTD_STEP_EVERY": "5",
        "LTD_LIMIT": "100",
        "MAX_PRODUCTS": "50",
        "MAX_UPLOAD_MB": "25",
        "MAX_STORAGE_MB": "500",
        "PLATFORM_TAX_ENABLED": "false",
        "AI_GATEWAY_ID": "default",
        "STOREFRONT_AI_DAILY_LIMIT": "60",
        "STOREFRONT_AI_GLOBAL_DAILY_LIMIT": "400",
      },
      "ai": {
        "binding": "AI",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "coachlane-editor-demo",
          "database_id": "a711b058-274e-4b5f-8b2e-2305d5878bb5",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "coachlane-private-demo",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "FULFILLMENT",
            "queue": "coachlane-email-demo",
          },
        ],
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "coachlane-editor-demo",
        },
      ],
      "workers_dev": true,
      "preview_urls": false,
      "minify": true,
    },
    "staging": {
      "name": "coachlane-staging",
      "send_email": [
        {
          "name": "LOGIN_EMAIL",
          "allowed_sender_addresses": ["login@getsore.me"],
        },
      ],
      "analytics_engine_datasets": [
        {
          "binding": "STOREFRONT_ANALYTICS",
          "dataset": "sore_storefront_staging",
        },
      ],
      "ratelimits": [
        {
          "name": "ANALYTICS_LIMITER",
          "namespace_id": "63",
          "simple": { "limit": 120, "period": 60 },
        },
      ],
      "vars": {
        "ANALYTICS_DATASET": "sore_storefront_staging",
        "APP_MODE": "production",
        "APP_URL": "https://getsore.me",
        "MCP_URL": "https://mcp.getsore.me",
        "PLATFORM_FEE_BPS": "0",
        "LTD_PRICE_CENTS": "9900",
        "LTD_STEP_CENTS": "1000",
        "LTD_STEP_EVERY": "5",
        "LTD_LIMIT": "100",
        "MAX_PRODUCTS": "50",
        "MAX_UPLOAD_MB": "25",
        "MAX_STORAGE_MB": "500",
        "PLATFORM_TAX_ENABLED": "false",
        "STRIPE_LTD_PRODUCT_ID": "prod_VfOPDFsW1KGqds",
        "STRIPE_PUBLISHABLE_KEY": "pk_test_51UdkH5LKVkTyYf4FWQomxvjuo5q0QjJREUakLmUVqipWEV9wF24vArAsOAAYwXBp2CkTZZoN6XW0Un1lWGhrsbI000xvT18NCv",
        "ACCESS_ISSUER": "https://polished-butterfly-f3b5.cloudflareaccess.com",
        "ACCESS_AUDIENCE": "7bd5f246386c0e56384f7bdd5a11f26397ce7d2eb70879b490a0016b14d0ccdc",
        "AUTH_PROVIDER": "email",
        "OTP_FROM": "login@getsore.me",
        "AI_GATEWAY_ID": "default",
      },
      "ai": {
        "binding": "AI",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "coachlane-staging",
          "database_id": "ccf1fff4-4a18-4876-8b77-a7c284f32989",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "coachlane-private-staging",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "FULFILLMENT",
            "queue": "coachlane-email-staging",
          },
        ],
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "coachlane-staging",
        },
      ],
      "workers_dev": false,
      "minify": true,
      "routes": [
        {
          "pattern": "getsore.me",
          "custom_domain": true,
          "zone_name": "getsore.me",
        },
        {
          "pattern": "www.getsore.me",
          "custom_domain": true,
          "zone_name": "getsore.me",
        },
        {
          "pattern": "coachlane.getsore.me",
          "custom_domain": true,
          "zone_name": "getsore.me",
        },
      ],
    },
  },
  "account_id": "27478de5040614b0328a6976a52b57d1",
}
